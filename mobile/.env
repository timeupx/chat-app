# Base URL for the Express.js backend.
#
# - Android Emulator: 10.0.2.2 maps to your host machine's "localhost".
# - iOS Simulator: localhost/127.0.0.1 works directly (same machine).
# - Physical device (Android or iOS): replace with your computer's LAN IP,
#   e.g. http://192.168.0.110:4000 - find it with `ipconfig getifaddr en0` (macOS)
#   or `ipconfig` (Windows). The phone and computer must be on the same Wi-Fi network.
# Physical phone on same Wi‑Fi as this Mac. For Android emulator use 10.0.2.2 instead.
BASE_URL=http://192.168.10.210:4000

# Used instead of BASE_URL when running on Flutter Web (kIsWeb), since the
# browser talks to the backend directly over localhost - not through the
# Android emulator's 10.0.2.2 alias.
WEB_BASE_URL=http://localhost:4000

# --- LiveKit ---
# Points at LiveKit Cloud today. To switch to a self-hosted LiveKit server
# later, change ONLY these three values - no app code changes needed:
#   LIVEKIT_URL=wss://your-project.livekit.cloud        (Cloud)
#   LIVEKIT_URL=wss://your-self-hosted-domain.com       (self-hosted)
LIVEKIT_URL=wss://chatapp-14t72612.livekit.cloud
LIVEKIT_API_KEY=APIe435Kvrmgcy3
