// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum AccountStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  USED
}

enum VerificationCodeType {
  ACCOUNT_ACTIVATION
  PASSWORD_RESET
  MFA_AUTH
  MFA_AUTH_DISABLE
  PHONE_CHANGE
  AUTHORITY_CHECK
}

/**
 * ***********************************************************************************
 * User and authentication
 * ***********************************************************************************
 */
model User {
  id                  String        @id @default(cuid())
  name                String
  email               String        @unique
  phone               String?       @unique
  password            String
  passChangedAt       DateTime?
  role                Role          @default(USER)
  status              AccountStatus @default(PENDING)
  photo               String?
  address             String?
  bio                 String?
  emailVerified       Boolean       @default(false)
  phoneVerified       Boolean       @default(false)
  mfaEnabled          Boolean       @default(false)
  needsPasswordChange Boolean       @default(false)
  isDeleted           Boolean       @default(false)

  // Relationships
  loginHistories    LoginHistory[]
  verificationCodes Verification[]
  trustedDevice     TrustedDevice[]
  roomBansReceived  RoomBan[]       @relation("BannedUser")
  roomBansIssued    RoomBan[]       @relation("BannedByUser")
  liveRooms         LiveRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
}

model LoginHistory {
  id         String   @id @default(cuid())
  userId     String
  ipAddress  String?
  device     String?
  browser    String?
  location   String?
  successful Boolean
  createdAt  DateTime @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String               @id @default(cuid())
  userId     String
  code       String
  status     VerificationStatus   @default(PENDING)
  type       VerificationCodeType
  issuedAt   DateTime             @default(now())
  expiresAt  DateTime
  verifiedAt DateTime?

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailHistory {
  id        String   @id @default(cuid())
  sender    String
  recipient String
  subject   String
  body      String
  source    String
  sentAt    DateTime @default(now())
}

model TrustedDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceToken String
  ip          String?
  userAgent   String?
  browser     String?
  location    String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  // Relationships
  user User @relation(fields: [userId], references: [id])
}

/**
 * ***********************************************************************************
 * Live streaming rooms
 * ***********************************************************************************
 */

// A persistent "channel" a host sets up once via CreateLiveRoomScreen. It
// can be toggled live/offline many times (isLive) - the LiveKit room
// identifier used for the actual video session is simply this row's `id`.
model LiveRoom {
  id        String   @id @default(cuid())
  hostId    String
  roomName  String
  roomImage String
  is18Plus  Boolean  @default(false)
  roomRules String
  isLive    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  host     User          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  messages LiveMessage[]

  @@index([hostId])
}

// One row per chat message sent in a live room. Only the last 50 (by
// createdAt) are ever returned to a client - see live-room.service.ts.
model LiveMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  name      String
  message   String
  createdAt DateTime @default(now())

  // Relationships
  room LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

// Persistent ban record: a banned user is rejected at the LiveKit token
// endpoint AND at socket room-join, until a host explicitly unbans them
// (which just deletes this row). `roomName` here holds the same value as
// LiveRoom.id (see above) - kept as a loose string rather than a hard FK
// so ban history can outlive a deleted room.
model RoomBan {
  id        String   @id @default(cuid())
  roomName  String
  userId    String
  bannedBy  String
  reason    String?
  createdAt DateTime @default(now())

  // Relationships
  user         User @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedByUser User @relation("BannedByUser", fields: [bannedBy], references: [id], onDelete: Cascade)

  @@unique([roomName, userId])
  @@index([roomName])
}

/**
 * ***********************************************************************************
 * Contact message
 * ***********************************************************************************
 */

model ContactMessage {
  id        String   @id @default(cuid())
  subject   String
  name      String
  email     String
  phone     String
  message   String
  isRead    Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * ***********************************************************************************
 * System settings
 * ***********************************************************************************
 */

model SystemSettings {
  id              String        @id @default(cuid())
  metaTitle       String?
  metaDescription String?
  allowSignup     Boolean       @default(true)
  maintenanceMode Boolean       @default(false)
  contactId       String?       @unique
  intigrationId   String?       @unique
  analyticsSeoId  String?       @unique
  appearanceId    String?       @unique
  contact         Contact?      @relation(fields: [contactId], references: [id])
  intigration     Intigrations? @relation(fields: [intigrationId], references: [id])
  analyticsSeo    AnalyticsSeo? @relation(fields: [analyticsSeoId], references: [id])
  appearance      Appearance?   @relation(fields: [appearanceId], references: [id])
}

model Contact {
  id             String          @id @default(cuid())
  email          String?
  phone          String?
  address        String?
  facebook       String?
  x              String?
  instagram      String?
  youtube        String?
  systemSettings SystemSettings?
}

model Intigrations {
  id             String          @id @default(cuid())
  smsApiKey      String?
  emailApiKey    String?
  systemSettings SystemSettings?
}

model AnalyticsSeo {
  id             String          @id @default(cuid())
  gatId          String?
  gtmId          String?
  pixelId        String?
  systemSettings SystemSettings?
}

model Appearance {
  id             String          @id @default(cuid())
  logo           String?
  favicon        String?
  theme          String?
  themeMode      String?
  SystemSettings SystemSettings?
}
